# Obsidian per-device / cache / trash
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/workspaces.json
.obsidian/cache/
.obsidian/*.cache
.trash/
.DS_Store
Thumbs.db

# Sync / lock / secrets that must never be committed
.obsidian/.sync.lock
.obsidian/graph.json.bak
*.pem
*.key
.env
.env.*

# Fonts are installed system-wide, never committed (see .obsidian/fonts/FONTS.md)
.obsidian/fonts/*
!.obsidian/fonts/FONTS.md

# Tapedeck's tape index holds local session titles and paths. Its data.json is
# committed only for importFolder; keep local session directories out of it
.obsidian/plugins/tapedeck/tape-cache.json
